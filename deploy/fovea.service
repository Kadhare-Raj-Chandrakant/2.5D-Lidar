[Unit]
Description=Fovea headless simulation telemetry backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/fovea

# WS_HOST must be 0.0.0.0 or the server binds loopback only and is unreachable
# from Caddy.
Environment=WS_HOST=0.0.0.0
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/docker run --rm --name fovea-backend \
    --network host \
    -e WS_HOST=0.0.0.0 \
    -e PYTHONUNBUFFERED=1 \
    fovea-backend:latest

Restart=always
RestartSec=2

# Stop sending SIGTERM to docker, wait for the graceful shutdown, then kill it.
KillSignal=SIGINT
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fovea-backend

[Install]
WantedBy=multi-user.target
